<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="800.0" prefWidth="1048.0"
            styleClass="pageRoot"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.BillingCollectionsController">

    <stylesheets>
        <URL value="@../Assets/css/pages.css" />
    </stylesheets>

    <children>
        <VBox layoutX="35.0" layoutY="30.0" spacing="6.0">
            <Label text="Thu tiền" styleClass="pageTitle" />
            <Label text="Lập phiếu thu dựa trên tổng tiền phiếu sửa chữa." styleClass="pageSubtitle" />
        </VBox>

        <HBox layoutX="35.0" layoutY="100.0" spacing="18.0">
            <VBox prefWidth="305.0" prefHeight="100.0" spacing="8.0" styleClass="smallCard">
                <Label text="Tổng tiền sửa chữa" styleClass="cardLabel" />
                <Label fx:id="lblRepairTotal" text="0đ" styleClass="cardValue" />
            </VBox>

            <VBox prefWidth="305.0" prefHeight="100.0" spacing="8.0" styleClass="smallCard">
                <Label text="Đã thu" styleClass="cardLabel" />
                <Label fx:id="lblAmountPaid" text="0đ" styleClass="cardValue" />
            </VBox>

            <VBox prefWidth="305.0" prefHeight="100.0" spacing="8.0" styleClass="smallCard">
                <Label text="Còn lại" styleClass="cardLabel" />
                <Label fx:id="lblRemainingDebt" text="0đ" styleClass="cardValue" />
            </VBox>
        </HBox>

        <VBox layoutX="35.0" layoutY="230.0" prefWidth="975.0" prefHeight="220.0" spacing="14.0" styleClass="card">
            <Label text="Phiếu thu tiền" styleClass="sectionTitle" />

            <GridPane hgap="18.0" vgap="12.0">
                <Label text="Mã phiếu thu" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtMaPhieuThu" promptText="PT06" styleClass="inputField" prefWidth="180.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Mã sửa chữa" styleClass="formLabel" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                <ComboBox fx:id="cbbMaSuaChuaXe" promptText="Chọn phiếu sửa chữa" styleClass="comboBox" prefWidth="220.0" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                <Label text="Mã tiếp nhận" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="txtMaTiepNhanXe" promptText="Tự động điền" styleClass="inputField" prefWidth="180.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Ngày thu" styleClass="formLabel" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <DatePicker fx:id="dpNgayThuTien" styleClass="datePicker" prefWidth="220.0" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                <Label text="Số tiền thu" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="txtSoTienThu" promptText="Tự động tính" styleClass="inputField" prefWidth="180.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            </GridPane>

            <HBox spacing="12.0">
                <Button fx:id="btnCreateReceipt" text="Tạo phiếu thu" styleClass="primaryBtn" prefWidth="135.0" />
                <Button fx:id="btnUpdateReceipt" text="Cập nhật" styleClass="secondaryBtn" prefWidth="100.0" />
                <Button fx:id="btnDeleteReceipt" text="Xóa" styleClass="dangerBtn" prefWidth="100.0" />
                <Button fx:id="btnClearReceipt" text="Làm mới" styleClass="secondaryBtn" prefWidth="100.0" />
            </HBox>
        </VBox>

        <VBox layoutX="35.0" layoutY="480.0" prefWidth="975.0" prefHeight="275.0" spacing="12.0" styleClass="card">
            <HBox spacing="12.0">
                <TextField fx:id="txtSearchReceipt" promptText="Tìm theo phiếu thu, mã sửa chữa, mã tiếp nhận, biển số..." styleClass="inputField" prefWidth="735.0" />
                <Button fx:id="btnSearchReceipt" text="Tìm kiếm" styleClass="primaryBtn" prefWidth="100.0" />
                <Button fx:id="btnRefreshReceipt" text="Tải lại" styleClass="secondaryBtn" prefWidth="100.0" />
            </HBox>

            <TableView fx:id="tblReceipts" prefWidth="935.0" prefHeight="200.0" styleClass="dataTable">
                <columns>
                    <TableColumn fx:id="colMaPhieuThu" text="Mã phiếu thu" prefWidth="115.0" />
                    <TableColumn fx:id="colMaSuaChuaXe" text="Mã sửa chữa" prefWidth="115.0" />
                    <TableColumn fx:id="colMaTiepNhanXe" text="Mã tiếp nhận" prefWidth="115.0" />
                    <TableColumn fx:id="colBienSoXe" text="Biển số xe" prefWidth="135.0" />
                    <TableColumn fx:id="colNgayThuTien" text="Ngày thu" prefWidth="130.0" />
                    <TableColumn fx:id="colSoDienThoai" text="SĐT" prefWidth="150.0" />
                    <TableColumn fx:id="colSoTienThu" text="Số tiền" prefWidth="150.0" />
                </columns>
            </TableView>
        </VBox>
    </children>
</AnchorPane>
