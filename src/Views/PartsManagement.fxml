<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="800.0" prefWidth="1048.0"
            styleClass="pageRoot"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1">

    <stylesheets>
        <URL value="@../Assets/css/pages.css" />
    </stylesheets>

    <children>
        <VBox layoutX="35.0" layoutY="30.0" spacing="6.0">
            <Label text="Parts Management" styleClass="pageTitle" />
            <Label text="Manage parts inventory, import parts, sell parts and monitor stock quantity." styleClass="pageSubtitle" />
        </VBox>

        <HBox layoutX="35.0" layoutY="100.0" spacing="18.0">
            <VBox prefWidth="305.0" prefHeight="100.0" spacing="8.0" styleClass="smallCard">
                <Label text="Total Parts" styleClass="cardLabel" />
                <Label fx:id="lblTotalParts" text="0" styleClass="cardValue" />
            </VBox>

            <VBox prefWidth="305.0" prefHeight="100.0" spacing="8.0" styleClass="smallCard">
                <Label text="Low Stock" styleClass="cardLabel" />
                <Label fx:id="lblLowStock" text="0" styleClass="cardValue" />
            </VBox>

            <VBox prefWidth="305.0" prefHeight="100.0" spacing="8.0" styleClass="smallCard">
                <Label text="Inventory Value" styleClass="cardLabel" />
                <Label fx:id="lblInventoryValue" text="0đ" styleClass="cardValue" />
            </VBox>
        </HBox>

        <VBox layoutX="35.0" layoutY="230.0" prefWidth="975.0" prefHeight="245.0" spacing="14.0" styleClass="card">
            <Label text="Part Information" styleClass="sectionTitle" />

            <GridPane hgap="18.0" vgap="12.0">
                <Label text="Part ID" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtMaVatTu" promptText="VT001" styleClass="inputField" prefWidth="180.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Part Name" styleClass="formLabel" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                <TextField fx:id="txtTenVatTu" promptText="Engine oil, brake pad..." styleClass="inputField" prefWidth="240.0" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                <Label text="Unit" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <ComboBox fx:id="cbbDonViTinh" promptText="Choose unit" styleClass="comboBox" prefWidth="180.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Quantity" styleClass="formLabel" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <TextField fx:id="txtSoLuongTon" promptText="0" styleClass="inputField" prefWidth="240.0" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                <Label text="Import Price" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="txtGiaNhap" promptText="0" styleClass="inputField" prefWidth="180.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Sell Price" styleClass="formLabel" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                <TextField fx:id="txtGiaBan" promptText="0" styleClass="inputField" prefWidth="240.0" GridPane.columnIndex="3" GridPane.rowIndex="2" />
            </GridPane>

            <HBox spacing="12.0">
                <Button fx:id="btnAddPart" text="Add Part" styleClass="primaryBtn" prefWidth="105.0" />
                <Button fx:id="btnImportPart" text="Import" styleClass="secondaryBtn" prefWidth="95.0" />
                <Button fx:id="btnSellPart" text="Sell" styleClass="secondaryBtn" prefWidth="95.0" />
                <Button fx:id="btnUpdatePart" text="Update" styleClass="secondaryBtn" prefWidth="95.0" />
                <Button fx:id="btnDeletePart" text="Delete" styleClass="dangerBtn" prefWidth="95.0" />
            </HBox>
        </VBox>

        <VBox layoutX="35.0" layoutY="505.0" prefWidth="975.0" prefHeight="250.0" spacing="12.0" styleClass="card">
            <HBox spacing="12.0">
                <TextField fx:id="txtSearchPart" promptText="Search part ID, part name..." styleClass="inputField" prefWidth="735.0" />
                <Button fx:id="btnSearchPart" text="Search" styleClass="primaryBtn" prefWidth="100.0" />
                <Button fx:id="btnRefreshPart" text="Refresh" styleClass="secondaryBtn" prefWidth="100.0" />
            </HBox>

            <TableView fx:id="tblParts" prefWidth="935.0" prefHeight="175.0" styleClass="dataTable">
                <columns>
                    <TableColumn fx:id="colMaVatTu" text="Part ID" prefWidth="120.0" />
                    <TableColumn fx:id="colTenVatTu" text="Part Name" prefWidth="250.0" />
                    <TableColumn fx:id="colDonViTinh" text="Unit" prefWidth="110.0" />
                    <TableColumn fx:id="colSoLuongTon" text="Quantity" prefWidth="130.0" />
                    <TableColumn fx:id="colGiaNhap" text="Import Price" prefWidth="160.0" />
                    <TableColumn fx:id="colGiaBan" text="Sell Price" prefWidth="160.0" />
                </columns>
            </TableView>
        </VBox>
    </children>
</AnchorPane>