<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="800.0" prefWidth="1048.0"
            styleClass="pageRoot"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.SettingsController">

    <stylesheets>
        <URL value="@../Assets/css/pages.css" />
    </stylesheets>

    <children>
        <VBox layoutX="35.0" layoutY="30.0" spacing="6.0">
            <Label text="Settings" styleClass="pageTitle" />
            <Label text="Manage profile, labor fee, suppliers and car brands." styleClass="pageSubtitle" />
        </VBox>

        <TabPane layoutX="35.0" layoutY="100.0" prefWidth="975.0" prefHeight="655.0"
                 tabClosingPolicy="UNAVAILABLE"
                 tabMinWidth="145.0"
                 tabMaxWidth="145.0"
                 tabMinHeight="36.0"
                 tabMaxHeight="36.0"
                 styleClass="settingsTabPane">

            <tabs>
                <Tab text="Profile">
                    <AnchorPane prefWidth="975.0" prefHeight="610.0" styleClass="pageRoot">
                        <children>
                            <VBox layoutX="15.0" layoutY="15.0" prefWidth="940.0" prefHeight="260.0" spacing="16.0" styleClass="card">
                                <Label text="User Profile" styleClass="sectionTitle" />

                                <GridPane hgap="22.0" vgap="14.0">
                                    <Label text="User ID" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                    <TextField fx:id="txtSettingMaNguoiDung" styleClass="inputField" prefWidth="220.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                    <Label text="Username" styleClass="formLabel" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                    <TextField fx:id="txtSettingUsername" styleClass="inputField" prefWidth="220.0" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                                    <Label text="Role" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                    <TextField fx:id="txtSettingRole" styleClass="inputField" prefWidth="220.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                </GridPane>

                                <HBox spacing="12.0">
                                    <Button fx:id="btnUpdateProfile" text="Update Profile" styleClass="primaryBtn" prefWidth="135.0" />
                                    <Button fx:id="btnRefreshProfile" text="Refresh" styleClass="secondaryBtn" prefWidth="100.0" />
                                    <Button fx:id="btnLogout" text="Logout" styleClass="dangerBtn" prefWidth="100.0" />
                                </HBox>
                            </VBox>

                            <VBox layoutX="15.0" layoutY="300.0" prefWidth="940.0" prefHeight="240.0" spacing="16.0" styleClass="card">
                                <Label text="Change Password" styleClass="sectionTitle" />

                                <GridPane hgap="22.0" vgap="14.0">
                                    <Label text="Old Password" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                    <PasswordField fx:id="txtOldPassword" styleClass="inputField" prefWidth="220.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                    <Label text="New Password" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                    <PasswordField fx:id="txtNewPassword" styleClass="inputField" prefWidth="220.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                    <Label text="Confirm Password" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                    <PasswordField fx:id="txtConfirmPassword" styleClass="inputField" prefWidth="220.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                </GridPane>

                                <HBox spacing="12.0">
                                    <Button fx:id="btnChangePassword" text="Change Password" styleClass="primaryBtn" prefWidth="160.0" />
                                    <Button fx:id="btnResetPasswordForm" text="Clear" styleClass="secondaryBtn" prefWidth="100.0" />
                                </HBox>
                            </VBox>
                        </children>
                    </AnchorPane>
                </Tab>

                <Tab text="Labor Fee">
                    <AnchorPane prefWidth="975.0" prefHeight="610.0" styleClass="pageRoot">
                        <children>
                            <VBox layoutX="15.0" layoutY="15.0" prefWidth="940.0" prefHeight="200.0" spacing="14.0" styleClass="card">
                                <Label text="Labor Fee Form" styleClass="sectionTitle" />

                                <GridPane hgap="20.0" vgap="14.0">
                                    <Label text="Labor ID" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                    <TextField fx:id="txtMaTienCong" promptText="TC01" styleClass="inputField" prefWidth="180.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                    <Label text="Description" styleClass="formLabel" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                    <TextField fx:id="txtNoiDungTienCong" promptText="Thay nhớt..." styleClass="inputField" prefWidth="260.0" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                                    <Label text="Amount" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                    <TextField fx:id="txtSoTienCong" promptText="50000" styleClass="inputField" prefWidth="180.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                </GridPane>

                                <HBox spacing="12.0">
                                    <Button fx:id="btnAddLabor" text="Add" styleClass="primaryBtn" prefWidth="90.0" />
                                    <Button fx:id="btnUpdateLabor" text="Update" styleClass="secondaryBtn" prefWidth="90.0" />
                                    <Button fx:id="btnDeleteLabor" text="Delete" styleClass="dangerBtn" prefWidth="90.0" />
                                    <Button fx:id="btnClearLabor" text="Clear" styleClass="secondaryBtn" prefWidth="90.0" />
                                </HBox>
                            </VBox>

                            <VBox layoutX="15.0" layoutY="240.0" prefWidth="940.0" prefHeight="350.0" spacing="12.0" styleClass="card">
                                <Label text="Labor Fee List" styleClass="sectionTitle" />

                                <TableView fx:id="tblLabor" prefWidth="900.0" prefHeight="280.0" styleClass="dataTable">
                                    <columns>
                                        <TableColumn fx:id="colLaborId" text="Labor ID" prefWidth="160.0" />
                                        <TableColumn fx:id="colLaborContent" text="Description" prefWidth="480.0" />
                                        <TableColumn fx:id="colLaborAmount" text="Amount" prefWidth="220.0" />
                                    </columns>
                                </TableView>
                            </VBox>
                        </children>
                    </AnchorPane>
                </Tab>

                <Tab text="Suppliers">
                    <AnchorPane prefWidth="975.0" prefHeight="610.0" styleClass="pageRoot">
                        <children>
                            <VBox layoutX="15.0" layoutY="15.0" prefWidth="940.0" prefHeight="225.0" spacing="14.0" styleClass="card">
                                <Label text="Supplier Form" styleClass="sectionTitle" />

                                <GridPane hgap="20.0" vgap="14.0">
                                    <Label text="Supplier ID" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                    <TextField fx:id="txtMaNhaCungCap" promptText="NCC01" styleClass="inputField" prefWidth="180.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                    <Label text="Supplier Name" styleClass="formLabel" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                    <TextField fx:id="txtTenNhaCungCap" promptText="Tên nhà cung cấp" styleClass="inputField" prefWidth="260.0" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                                    <Label text="Phone" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                    <TextField fx:id="txtSdtNhaCungCap" promptText="090..." styleClass="inputField" prefWidth="180.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                    <Label text="Email" styleClass="formLabel" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                    <TextField fx:id="txtEmailNhaCungCap" promptText="supplier@mail.com" styleClass="inputField" prefWidth="260.0" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                                </GridPane>

                                <HBox spacing="12.0">
                                    <Button fx:id="btnAddSupplier" text="Add" styleClass="primaryBtn" prefWidth="90.0" />
                                    <Button fx:id="btnUpdateSupplier" text="Update" styleClass="secondaryBtn" prefWidth="90.0" />
                                    <Button fx:id="btnDeleteSupplier" text="Delete" styleClass="dangerBtn" prefWidth="90.0" />
                                    <Button fx:id="btnClearSupplier" text="Clear" styleClass="secondaryBtn" prefWidth="90.0" />
                                </HBox>
                            </VBox>

                            <VBox layoutX="15.0" layoutY="265.0" prefWidth="940.0" prefHeight="325.0" spacing="12.0" styleClass="card">
                                <Label text="Supplier List" styleClass="sectionTitle" />

                                <TableView fx:id="tblSupplier" prefWidth="900.0" prefHeight="255.0" styleClass="dataTable">
                                    <columns>
                                        <TableColumn fx:id="colSupplierId" text="Supplier ID" prefWidth="140.0" />
                                        <TableColumn fx:id="colSupplierName" text="Name" prefWidth="280.0" />
                                        <TableColumn fx:id="colSupplierPhone" text="Phone" prefWidth="200.0" />
                                        <TableColumn fx:id="colSupplierEmail" text="Email" prefWidth="260.0" />
                                    </columns>
                                </TableView>
                            </VBox>
                        </children>
                    </AnchorPane>
                </Tab>

                <Tab text="Car Brands">
                    <AnchorPane prefWidth="975.0" prefHeight="610.0" styleClass="pageRoot">
                        <children>
                            <VBox layoutX="15.0" layoutY="15.0" prefWidth="940.0" prefHeight="185.0" spacing="14.0" styleClass="card">
                                <Label text="Car Brand Form" styleClass="sectionTitle" />

                                <GridPane hgap="20.0" vgap="14.0">
                                    <Label text="Brand ID" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                    <TextField fx:id="txtMaHieuXe" promptText="HX01" styleClass="inputField" prefWidth="180.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                    <Label text="Brand Name" styleClass="formLabel" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                    <TextField fx:id="txtTenHieuXe" promptText="Toyota, Honda..." styleClass="inputField" prefWidth="260.0" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                                </GridPane>

                                <HBox spacing="12.0">
                                    <Button fx:id="btnAddBrand" text="Add" styleClass="primaryBtn" prefWidth="90.0" />
                                    <Button fx:id="btnUpdateBrand" text="Update" styleClass="secondaryBtn" prefWidth="90.0" />
                                    <Button fx:id="btnDeleteBrand" text="Delete" styleClass="dangerBtn" prefWidth="90.0" />
                                    <Button fx:id="btnClearBrand" text="Clear" styleClass="secondaryBtn" prefWidth="90.0" />
                                </HBox>
                            </VBox>

                            <VBox layoutX="15.0" layoutY="225.0" prefWidth="940.0" prefHeight="365.0" spacing="12.0" styleClass="card">
                                <Label text="Car Brand List" styleClass="sectionTitle" />

                                <TableView fx:id="tblBrand" prefWidth="900.0" prefHeight="295.0" styleClass="dataTable">
                                    <columns>
                                        <TableColumn fx:id="colBrandId" text="Brand ID" prefWidth="200.0" />
                                        <TableColumn fx:id="colBrandName" text="Brand Name" prefWidth="650.0" />
                                    </columns>
                                </TableView>
                            </VBox>
                        </children>
                    </AnchorPane>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</AnchorPane>