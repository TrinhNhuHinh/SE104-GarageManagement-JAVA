<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="800.0" prefWidth="1048.0"
            styleClass="pageRoot"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.SettingsController">

    <stylesheets>
        <URL value="@../Assets/css/pages.css" />
    </stylesheets>

    <children>
        <VBox layoutX="35.0" layoutY="30.0" spacing="6.0">
            <Label text="Cài đặt" styleClass="pageTitle" />
            <Label text="Quản lý hồ sơ cá nhân, tiền công, nhà cung cấp và hiệu xe." styleClass="pageSubtitle" />
        </VBox>

        <TabPane fx:id="settingsTabPane"
                 layoutX="35.0" layoutY="100.0" prefWidth="975.0" prefHeight="655.0"
                 tabClosingPolicy="UNAVAILABLE"
                 tabMinWidth="145.0"
                 tabMaxWidth="145.0"
                 tabMinHeight="36.0"
                 tabMaxHeight="36.0"
                 styleClass="settingsTabPane">

            <tabs>
                <Tab text="Hồ sơ">
                    <AnchorPane prefWidth="975.0" prefHeight="610.0" styleClass="pageRoot">
                        <children>
                            <VBox layoutX="15.0" layoutY="15.0" prefWidth="940.0" prefHeight="260.0" spacing="16.0" styleClass="card">
                                <Label text="Thông tin người dùng" styleClass="sectionTitle" />

                                <GridPane hgap="22.0" vgap="14.0">
                                    <Label text="Mã người dùng" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                    <TextField fx:id="txtSettingMaNguoiDung" styleClass="inputField" prefWidth="220.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                    <Label text="Tài khoản" styleClass="formLabel" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                    <TextField fx:id="txtSettingUsername" styleClass="inputField" prefWidth="220.0" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                                    <Label text="Vai trò" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                    <TextField fx:id="txtSettingRole" styleClass="inputField" prefWidth="220.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                </GridPane>

                                <HBox spacing="12.0">
                                    <Button fx:id="btnUpdateProfile" text="Cập nhật" styleClass="primaryBtn" prefWidth="135.0" />
                                    <Button fx:id="btnRefreshProfile" text="Làm mới" styleClass="secondaryBtn" prefWidth="100.0" />
                                    <Button fx:id="btnLogout" text="Đăng xuất" styleClass="dangerBtn" prefWidth="100.0" />
                                </HBox>
                            </VBox>

                            <VBox layoutX="15.0" layoutY="300.0" prefWidth="940.0" prefHeight="240.0" spacing="16.0" styleClass="card">
                                <Label text="Đổi mật khẩu" styleClass="sectionTitle" />

                                <GridPane hgap="22.0" vgap="14.0">
                                    <Label text="Mật khẩu cũ" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                    <PasswordField fx:id="txtOldPassword" styleClass="inputField" prefWidth="220.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                    <Label text="Mật khẩu mới" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                    <PasswordField fx:id="txtNewPassword" styleClass="inputField" prefWidth="220.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                    <Label text="Xác nhận mật khẩu" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                    <PasswordField fx:id="txtConfirmPassword" styleClass="inputField" prefWidth="220.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                </GridPane>

                                <HBox spacing="12.0">
                                    <Button fx:id="btnChangePassword" text="Đổi mật khẩu" styleClass="primaryBtn" prefWidth="160.0" />
                                    <Button fx:id="btnResetPasswordForm" text="Xóa form" styleClass="secondaryBtn" prefWidth="100.0" />
                                </HBox>
                            </VBox>
                        </children>
                    </AnchorPane>
                </Tab>

                <Tab fx:id="tabUsers" text="Tài khoản">
                    <AnchorPane prefWidth="975.0" prefHeight="610.0" styleClass="pageRoot">
                        <children>
                            <VBox layoutX="15.0" layoutY="15.0" prefWidth="940.0" prefHeight="220.0" spacing="14.0" styleClass="card">
                                <Label text="Quản lý tài khoản" styleClass="sectionTitle" />

                                <GridPane hgap="20.0" vgap="14.0">
                                    <Label text="Mã người dùng" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                    <TextField fx:id="txtUserId" promptText="Tự động" styleClass="inputField" prefWidth="180.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                    <Label text="Tên tài khoản" styleClass="formLabel" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                    <TextField fx:id="txtUserName" promptText="username" styleClass="inputField" prefWidth="240.0" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                                    <Label text="Mật khẩu" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                    <PasswordField fx:id="txtUserPassword" promptText="Ít nhất 6 ký tự" styleClass="inputField" prefWidth="180.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                    <Label text="Vai trò" styleClass="formLabel" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                    <ComboBox fx:id="cbbUserRole" promptText="Chọn vai trò" styleClass="comboBox" prefWidth="240.0" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                                </GridPane>

                                <HBox spacing="12.0">
                                    <Button fx:id="btnAddUser" text="Thêm" styleClass="primaryBtn" prefWidth="90.0" />
                                    <Button fx:id="btnUpdateUser" text="Sửa" styleClass="secondaryBtn" prefWidth="90.0" />
                                    <Button fx:id="btnDeleteUser" text="Xóa" styleClass="dangerBtn" prefWidth="90.0" />
                                    <Button fx:id="btnClearUser" text="Làm mới" styleClass="secondaryBtn" prefWidth="100.0" />
                                </HBox>
                            </VBox>

                            <VBox layoutX="15.0" layoutY="260.0" prefWidth="940.0" prefHeight="330.0" spacing="12.0" styleClass="card">
                                <Label text="Danh sách tài khoản" styleClass="sectionTitle" />

                                <TableView fx:id="tblUsers" prefWidth="900.0" prefHeight="260.0" styleClass="dataTable">
                                    <columns>
                                        <TableColumn fx:id="colUserId" text="Mã người dùng" prefWidth="220.0" />
                                        <TableColumn fx:id="colUserName" text="Tên tài khoản" prefWidth="360.0" />
                                        <TableColumn fx:id="colUserRole" text="Vai trò" prefWidth="320.0" />
                                    </columns>
                                </TableView>
                            </VBox>
                        </children>
                    </AnchorPane>
                </Tab>

                <Tab fx:id="tabLabor" text="Tiền công">
                    <AnchorPane prefWidth="975.0" prefHeight="610.0" styleClass="pageRoot">
                        <children>
                            <VBox layoutX="15.0" layoutY="15.0" prefWidth="940.0" prefHeight="200.0" spacing="14.0" styleClass="card">
                                <Label text="Thông tin tiền công" styleClass="sectionTitle" />

                                <GridPane hgap="20.0" vgap="14.0">
                                    <Label text="Mã tiền công" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                    <TextField fx:id="txtMaTienCong" promptText="TC01" styleClass="inputField" prefWidth="180.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                    <Label text="Nội dung" styleClass="formLabel" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                    <TextField fx:id="txtNoiDungTienCong" promptText="Thay nhớt..." styleClass="inputField" prefWidth="260.0" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                                    <Label text="Số tiền" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                    <TextField fx:id="txtSoTienCong" promptText="50000" styleClass="inputField" prefWidth="180.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                </GridPane>

                                <HBox spacing="12.0">
                                    <Button fx:id="btnAddLabor" text="Thêm" styleClass="primaryBtn" prefWidth="90.0" />
                                    <Button fx:id="btnUpdateLabor" text="Sửa" styleClass="secondaryBtn" prefWidth="90.0" />
                                    <Button fx:id="btnDeleteLabor" text="Xóa" styleClass="dangerBtn" prefWidth="90.0" />
                                    <Button fx:id="btnClearLabor" text="Làm mới" styleClass="secondaryBtn" prefWidth="90.0" />
                                </HBox>
                            </VBox>

                            <VBox layoutX="15.0" layoutY="240.0" prefWidth="940.0" prefHeight="350.0" spacing="12.0" styleClass="card">
                                <Label text="Danh sách tiền công" styleClass="sectionTitle" />

                                <TableView fx:id="tblLabor" prefWidth="900.0" prefHeight="280.0" styleClass="dataTable">
                                    <columns>
                                        <TableColumn fx:id="colLaborId" text="Mã tiền công" prefWidth="160.0" />
                                        <TableColumn fx:id="colLaborContent" text="Nội dung" prefWidth="480.0" />
                                        <TableColumn fx:id="colLaborAmount" text="Số tiền" prefWidth="220.0" />
                                    </columns>
                                </TableView>
                            </VBox>
                        </children>
                    </AnchorPane>
                </Tab>

                <Tab fx:id="tabSuppliers" text="Nhà cung cấp">
                    <AnchorPane prefWidth="975.0" prefHeight="610.0" styleClass="pageRoot">
                        <children>
                            <VBox layoutX="15.0" layoutY="15.0" prefWidth="940.0" prefHeight="225.0" spacing="14.0" styleClass="card">
                                <Label text="Thông tin nhà cung cấp" styleClass="sectionTitle" />

                                <GridPane hgap="20.0" vgap="14.0">
                                    <Label text="Mã nhà cung cấp" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                    <TextField fx:id="txtMaNhaCungCap" promptText="NCC01" styleClass="inputField" prefWidth="180.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                    <Label text="Tên nhà cung cấp" styleClass="formLabel" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                    <TextField fx:id="txtTenNhaCungCap" promptText="Tên nhà cung cấp" styleClass="inputField" prefWidth="260.0" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                                    <Label text="Số điện thoại" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                    <TextField fx:id="txtSdtNhaCungCap" promptText="090..." styleClass="inputField" prefWidth="180.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                    <Label text="Email" styleClass="formLabel" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                    <TextField fx:id="txtEmailNhaCungCap" promptText="supplier@mail.com" styleClass="inputField" prefWidth="260.0" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                                </GridPane>

                                <HBox spacing="12.0">
                                    <Button fx:id="btnAddSupplier" text="Thêm" styleClass="primaryBtn" prefWidth="90.0" />
                                    <Button fx:id="btnUpdateSupplier" text="Sửa" styleClass="secondaryBtn" prefWidth="90.0" />
                                    <Button fx:id="btnDeleteSupplier" text="Xóa" styleClass="dangerBtn" prefWidth="90.0" />
                                    <Button fx:id="btnClearSupplier" text="Làm mới" styleClass="secondaryBtn" prefWidth="90.0" />
                                </HBox>
                            </VBox>

                            <VBox layoutX="15.0" layoutY="265.0" prefWidth="940.0" prefHeight="325.0" spacing="12.0" styleClass="card">
                                <Label text="Danh sách nhà cung cấp" styleClass="sectionTitle" />

                                <TableView fx:id="tblSupplier" prefWidth="900.0" prefHeight="255.0" styleClass="dataTable">
                                    <columns>
                                        <TableColumn fx:id="colSupplierId" text="Mã NCC" prefWidth="140.0" />
                                        <TableColumn fx:id="colSupplierName" text="Tên nhà cung cấp" prefWidth="280.0" />
                                        <TableColumn fx:id="colSupplierPhone" text="Số điện thoại" prefWidth="200.0" />
                                        <TableColumn fx:id="colSupplierEmail" text="Email" prefWidth="260.0" />
                                    </columns>
                                </TableView>
                            </VBox>
                        </children>
                    </AnchorPane>
                </Tab>

                <Tab fx:id="tabBrands" text="Hiệu xe">
                    <AnchorPane prefWidth="975.0" prefHeight="610.0" styleClass="pageRoot">
                        <children>
                            <VBox layoutX="15.0" layoutY="15.0" prefWidth="940.0" prefHeight="185.0" spacing="14.0" styleClass="card">
                                <Label text="Thông tin hiệu xe" styleClass="sectionTitle" />

                                <GridPane hgap="20.0" vgap="14.0">
                                    <Label text="Mã hiệu xe" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                    <TextField fx:id="txtMaHieuXe" promptText="HX01" styleClass="inputField" prefWidth="180.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                    <Label text="Tên hiệu xe" styleClass="formLabel" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                    <TextField fx:id="txtTenHieuXe" promptText="Toyota, Honda..." styleClass="inputField" prefWidth="260.0" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                                </GridPane>

                                <HBox spacing="12.0">
                                    <Button fx:id="btnAddBrand" text="Thêm" styleClass="primaryBtn" prefWidth="90.0" />
                                    <Button fx:id="btnUpdateBrand" text="Sửa" styleClass="secondaryBtn" prefWidth="90.0" />
                                    <Button fx:id="btnDeleteBrand" text="Xóa" styleClass="dangerBtn" prefWidth="90.0" />
                                    <Button fx:id="btnClearBrand" text="Làm mới" styleClass="secondaryBtn" prefWidth="90.0" />
                                </HBox>
                            </VBox>

                            <VBox layoutX="15.0" layoutY="225.0" prefWidth="940.0" prefHeight="365.0" spacing="12.0" styleClass="card">
                                <Label text="Danh sách hiệu xe" styleClass="sectionTitle" />

                                <TableView fx:id="tblBrand" prefWidth="900.0" prefHeight="295.0" styleClass="dataTable">
                                    <columns>
                                        <TableColumn fx:id="colBrandId" text="Mã hiệu xe" prefWidth="200.0" />
                                        <TableColumn fx:id="colBrandName" text="Tên hiệu xe" prefWidth="650.0" />
                                    </columns>
                                </TableView>
                            </VBox>
                        </children>
                    </AnchorPane>
                </Tab>

                <Tab fx:id="tabRoles" text="Vai tro">
                    <AnchorPane prefWidth="975.0" prefHeight="610.0" styleClass="pageRoot">
                        <children>
                            <VBox layoutX="15.0" layoutY="15.0" prefWidth="940.0" prefHeight="205.0" spacing="14.0" styleClass="card">
                                <Label text="Quan ly vai tro" styleClass="sectionTitle" />

                                <GridPane hgap="20.0" vgap="14.0">
                                    <Label text="Ma vai tro" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                    <TextField fx:id="txtRoleId" promptText="Tu dong" styleClass="inputField" prefWidth="180.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                    <Label text="Ten vai tro" styleClass="formLabel" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                    <TextField fx:id="txtRoleName" promptText="Ke toan, tho sua..." styleClass="inputField" prefWidth="260.0" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                                </GridPane>

                                <HBox spacing="12.0">
                                    <Button fx:id="btnAddRole" text="Them" styleClass="primaryBtn" prefWidth="90.0" />
                                    <Button fx:id="btnUpdateRole" text="Sua" styleClass="secondaryBtn" prefWidth="90.0" />
                                    <Button fx:id="btnDeleteRole" text="Xoa" styleClass="dangerBtn" prefWidth="90.0" />
                                    <Button fx:id="btnClearRole" text="Lam moi" styleClass="secondaryBtn" prefWidth="100.0" />
                                </HBox>
                            </VBox>

                            <HBox layoutX="15.0" layoutY="245.0" prefWidth="940.0" prefHeight="345.0" spacing="16.0">
                                <VBox prefWidth="470.0" prefHeight="345.0" spacing="12.0" styleClass="card">
                                    <Label text="Danh sach vai tro" styleClass="sectionTitle" />
                                    <TableView fx:id="tblRoles" prefWidth="430.0" prefHeight="275.0" styleClass="dataTable">
                                        <columns>
                                            <TableColumn fx:id="colRoleId" text="Ma vai tro" prefWidth="150.0" />
                                            <TableColumn fx:id="colRoleName" text="Ten vai tro" prefWidth="270.0" />
                                        </columns>
                                    </TableView>
                                </VBox>

                                <VBox prefWidth="454.0" prefHeight="345.0" spacing="12.0" styleClass="card">
                                    <Label text="Quyen han" styleClass="sectionTitle" />
                                    <ListView fx:id="lstPermissions" prefWidth="414.0" prefHeight="275.0" styleClass="dataTable" />
                                </VBox>
                            </HBox>
                        </children>
                    </AnchorPane>
                </Tab>

                <Tab fx:id="tabRegulations" text="Quy dinh">
                    <AnchorPane prefWidth="975.0" prefHeight="610.0" styleClass="pageRoot">
                        <children>
                            <VBox layoutX="15.0" layoutY="15.0" prefWidth="940.0" prefHeight="310.0" spacing="16.0" styleClass="card">
                                <Label text="Thiet lap quy dinh" styleClass="sectionTitle" />

                                <GridPane hgap="22.0" vgap="16.0">
                                    <Label text="So xe toi da moi ngay" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                    <TextField fx:id="txtMaxCarsPerDay" promptText="30" styleClass="inputField" prefWidth="220.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                    <Label text="So hieu xe toi da" styleClass="formLabel" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                    <TextField fx:id="txtMaxBrands" promptText="10" styleClass="inputField" prefWidth="220.0" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                                    <Label text="So loai vat tu toi da" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                    <TextField fx:id="txtMaxParts" promptText="200" styleClass="inputField" prefWidth="220.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                    <Label text="So loai tien cong toi da" styleClass="formLabel" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                    <TextField fx:id="txtMaxLabors" promptText="100" styleClass="inputField" prefWidth="220.0" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                                    <Label text="VAT (%)" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                    <TextField fx:id="txtVatPercent" promptText="10" styleClass="inputField" prefWidth="220.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                    <Label text="Tang gia (%)" styleClass="formLabel" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                                    <TextField fx:id="txtPriceIncreasePercent" promptText="5" styleClass="inputField" prefWidth="220.0" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                                </GridPane>

                                <HBox spacing="12.0">
                                    <Button fx:id="btnUpdateRegulations" text="Cap nhat" styleClass="primaryBtn" prefWidth="120.0" />
                                    <Button fx:id="btnResetRegulations" text="Ve mac dinh" styleClass="secondaryBtn" prefWidth="130.0" />
                                    <Button fx:id="btnRefreshRegulations" text="Tai lai" styleClass="secondaryBtn" prefWidth="100.0" />
                                </HBox>
                            </VBox>
                        </children>
                    </AnchorPane>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</AnchorPane>
