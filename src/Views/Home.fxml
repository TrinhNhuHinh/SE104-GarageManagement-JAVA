               </children></AnchorPane>
         </left>
         <center>
            <AnchorPane fx:id="mainContent" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER" styleClass="mainContent"/>
         </center>
      </BorderPane>
   </children>
</AnchorPane>
