<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="800.0" prefWidth="1048.0"
            styleClass="pageRoot"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.QuickLookupController">

    <stylesheets>
        <URL value="@../Assets/css/pages.css" />
    </stylesheets>

    <children>
        <VBox layoutX="35.0" layoutY="30.0" spacing="6.0">
            <Label text="Quick Lookup" styleClass="pageTitle" />
            <Label text="Quickly search vehicles, customers, repair history and parts inventory." styleClass="pageSubtitle" />
        </VBox>

        <VBox layoutX="35.0" layoutY="105.0" prefWidth="975.0" prefHeight="130.0" spacing="16.0" styleClass="card">
            <Label text="Search Center" styleClass="sectionTitle" />

            <HBox spacing="12.0">
                <ComboBox fx:id="cbbLookupType" promptText="Lookup type" styleClass="comboBox" prefWidth="185.0" />
                <TextField fx:id="txtLookupKeyword" promptText="Enter license plate, customer name, phone, part name..." styleClass="inputField" prefWidth="575.0" />
                <Button fx:id="btnLookup" text="Lookup" styleClass="primaryBtn" prefWidth="100.0" />
                <Button fx:id="btnResetLookup" text="Reset" styleClass="secondaryBtn" prefWidth="80.0" />
            </HBox>
        </VBox>

        <HBox layoutX="35.0" layoutY="265.0" spacing="18.0">
            <VBox prefWidth="305.0" prefHeight="105.0" spacing="8.0" styleClass="smallCard">
                <Label text="Vehicles Found" styleClass="cardLabel" />
                <Label fx:id="lblVehiclesFound" text="0" styleClass="cardValue" />
            </VBox>

            <VBox prefWidth="305.0" prefHeight="105.0" spacing="8.0" styleClass="smallCard">
                <Label text="Parts Found" styleClass="cardLabel" />
                <Label fx:id="lblPartsFound" text="0" styleClass="cardValue" />
            </VBox>

            <VBox prefWidth="305.0" prefHeight="105.0" spacing="8.0" styleClass="smallCard">
                <Label text="Repair Records" styleClass="cardLabel" />
                <Label fx:id="lblRepairRecordsFound" text="0" styleClass="cardValue" />
            </VBox>
        </HBox>

        <VBox layoutX="35.0" layoutY="400.0" prefWidth="975.0" prefHeight="355.0" spacing="12.0" styleClass="card">
            <Label text="Lookup Results" styleClass="sectionTitle" />

            <TableView fx:id="tblLookupResults" prefWidth="935.0" prefHeight="285.0" styleClass="dataTable">
                <columns>
                    <TableColumn fx:id="colLookupType" text="Type" prefWidth="130.0" />
                    <TableColumn fx:id="colLookupCode" text="Code" prefWidth="140.0" />
                    <TableColumn fx:id="colLookupName" text="Name / Vehicle" prefWidth="240.0" />
                    <TableColumn fx:id="colLookupInfo" text="Information" prefWidth="300.0" />
                    <TableColumn fx:id="colLookupStatus" text="Status" prefWidth="120.0" />
                </columns>
            </TableView>
        </VBox>
    </children>
</AnchorPane>