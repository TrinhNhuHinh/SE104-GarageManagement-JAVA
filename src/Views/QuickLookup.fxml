<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="800.0" prefWidth="1048.0"
            styleClass="pageRoot"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.QuickLookupController">

    <stylesheets>
        <URL value="@../Assets/css/pages.css" />
    </stylesheets>

    <children>
        <VBox layoutX="35.0" layoutY="30.0" spacing="6.0">
            <Label text="Tra cứu nhanh" styleClass="pageTitle" />
            <Label text="Tra cứu xe, khách hàng, lịch sử sửa chữa và tồn kho vật tư." styleClass="pageSubtitle" />
        </VBox>

        <VBox layoutX="35.0" layoutY="105.0" prefWidth="975.0" prefHeight="130.0" spacing="16.0" styleClass="card">
            <Label text="Khu vực tìm kiếm" styleClass="sectionTitle" />

            <HBox spacing="12.0">
                <ComboBox fx:id="cbbLookupType" promptText="Loại tra cứu" styleClass="comboBox" prefWidth="185.0" />
                <TextField fx:id="txtLookupKeyword" promptText="Nhập biển số, tên khách hàng, SĐT, tên vật tư..." styleClass="inputField" prefWidth="575.0" />
                <Button fx:id="btnLookup" text="Tra cứu" styleClass="primaryBtn" prefWidth="100.0" />
                <Button fx:id="btnResetLookup" text="Đặt lại" styleClass="secondaryBtn" prefWidth="80.0" />
            </HBox>
        </VBox>

        <HBox layoutX="35.0" layoutY="265.0" spacing="18.0">
            <VBox prefWidth="305.0" prefHeight="105.0" spacing="8.0" styleClass="smallCard">
                <Label text="Xe tìm thấy" styleClass="cardLabel" />
                <Label fx:id="lblVehiclesFound" text="0" styleClass="cardValue" />
            </VBox>

            <VBox prefWidth="305.0" prefHeight="105.0" spacing="8.0" styleClass="smallCard">
                <Label text="Vật tư tìm thấy" styleClass="cardLabel" />
                <Label fx:id="lblPartsFound" text="0" styleClass="cardValue" />
            </VBox>

            <VBox prefWidth="305.0" prefHeight="105.0" spacing="8.0" styleClass="smallCard">
                <Label text="Phiếu sửa chữa" styleClass="cardLabel" />
                <Label fx:id="lblRepairRecordsFound" text="0" styleClass="cardValue" />
            </VBox>
        </HBox>

        <VBox layoutX="35.0" layoutY="400.0" prefWidth="975.0" prefHeight="355.0" spacing="12.0" styleClass="card">
            <Label text="Kết quả tra cứu" styleClass="sectionTitle" />

            <TableView fx:id="tblLookupResults" prefWidth="935.0" prefHeight="285.0" styleClass="dataTable">
                <columns>
                    <TableColumn fx:id="colLookupType" text="Loại" prefWidth="130.0" />
                    <TableColumn fx:id="colLookupCode" text="Mã" prefWidth="140.0" />
                    <TableColumn fx:id="colLookupName" text="Tên / Xe" prefWidth="240.0" />
                    <TableColumn fx:id="colLookupInfo" text="Thông tin" prefWidth="300.0" />
                    <TableColumn fx:id="colLookupStatus" text="Trạng thái" prefWidth="120.0" />
                </columns>
            </TableView>
        </VBox>
    </children>
</AnchorPane>
