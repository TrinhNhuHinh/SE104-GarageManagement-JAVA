<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane 
    prefHeight="800.0" 
    prefWidth="1048.0" 
    xmlns="http://javafx.com/javafx/26" 
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="Controllers.IntakeServiceController">

    <stylesheets>
        <URL value="@../Assets/css/intakeservice.css" />
    </stylesheets>

    <children>
        <VBox layoutX="40.0" layoutY="40.0" spacing="20.0">
            <Label text="Profile" styleClass="pageTitle"/>
            <Label text="Tên tài khoản:" />
            <TextField fx:id="txtUsername" promptText="Nhập tên..." />
            <Label text="Email:" />
            <TextField fx:id="txtEmail" promptText="Nhập email..." />
            <Button text="Lưu thay đổi" fx:id="btnSave" />
        </VBox>
    </children>

</AnchorPane>