<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="800.0" prefWidth="1048.0"
            styleClass="pageRoot"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.IntakeServiceController">

    <stylesheets>
        <URL value="@../Assets/css/pages.css" />
    </stylesheets>

    <children>
        <VBox layoutX="35.0" layoutY="30.0" spacing="6.0">
            <Label text="Tiếp nhận xe" styleClass="pageTitle" />
            <Label text="Tạo hồ sơ xe sửa chữa theo biển số và thông tin chủ xe." styleClass="pageSubtitle" />
        </VBox>

        <VBox layoutX="35.0" layoutY="100.0" prefWidth="975.0" prefHeight="230.0" spacing="14.0" styleClass="card">
            <Label text="Hồ sơ xe sửa chữa" styleClass="sectionTitle" />

            <GridPane hgap="18.0" vgap="12.0">
                <Label text="Mã hồ sơ" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtMaTiepNhanXe" promptText="TN01" styleClass="inputField" prefWidth="180.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Mã khách hàng" styleClass="formLabel" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                <TextField fx:id="txtMaKhachHang" promptText="KH01" styleClass="inputField" prefWidth="200.0" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                <Label text="Biển số xe" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="txtBienSoXe" promptText="51A12345" styleClass="inputField" prefWidth="180.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Hiệu xe" styleClass="formLabel" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <ComboBox fx:id="cbbMaHieuXe" promptText="Chọn hiệu xe" styleClass="comboBox" prefWidth="200.0" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                <Label text="Ngày tiếp nhận" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <DatePicker fx:id="dpNgayTiepNhan" styleClass="datePicker" prefWidth="180.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            </GridPane>

            <HBox spacing="12.0">
                <Button fx:id="btnAdd" text="Thêm" styleClass="primaryBtn" prefWidth="100.0" />
                <Button fx:id="btnUpdate" text="Cập nhật" styleClass="secondaryBtn" prefWidth="100.0" />
                <Button fx:id="btnDelete" text="Xóa" styleClass="dangerBtn" prefWidth="100.0" />
                <Button fx:id="btnClear" text="Làm mới" styleClass="secondaryBtn" prefWidth="100.0" />
            </HBox>
        </VBox>

        <VBox layoutX="35.0" layoutY="360.0" prefWidth="975.0" prefHeight="395.0" spacing="12.0" styleClass="card">
            <HBox spacing="12.0">
                <TextField fx:id="txtSearch" promptText="Tìm theo mã hồ sơ, mã khách hàng, biển số..." styleClass="inputField" prefWidth="735.0" />
                <Button fx:id="btnSearch" text="Tìm kiếm" styleClass="primaryBtn" prefWidth="100.0" />
                <Button fx:id="btnRefresh" text="Tải lại" styleClass="secondaryBtn" prefWidth="100.0" />
            </HBox>

            <TableView fx:id="tblTiepNhanXe" prefWidth="935.0" prefHeight="320.0" styleClass="dataTable">
                <columns>
                    <TableColumn fx:id="colMaTiepNhanXe" text="Mã hồ sơ" prefWidth="130.0" />
                    <TableColumn fx:id="colMaKhachHang" text="Mã khách hàng" prefWidth="150.0" />
                    <TableColumn fx:id="colBienSoXe" text="Biển số xe" prefWidth="160.0" />
                    <TableColumn fx:id="colMaHieuXe" text="Hiệu xe" prefWidth="150.0" />
                    <TableColumn fx:id="colNgayTiepNhan" text="Ngày tiếp nhận" prefWidth="160.0" />
                    <TableColumn fx:id="colTienNo" text="Tiền nợ" prefWidth="175.0" />
                </columns>
            </TableView>
        </VBox>
    </children>
</AnchorPane>
