<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="800.0" prefWidth="1048.0"
            styleClass="pageRoot"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.RegulationsController">

    <stylesheets>
        <URL value="@../Assets/css/pages.css" />
    </stylesheets>

    <children>
        <VBox layoutX="35.0" layoutY="30.0" spacing="6.0">
            <Label text="Quy định gara" styleClass="pageTitle" />
            <Label text="Điều chỉnh số xe tiếp nhận tối đa trong ngày." styleClass="pageSubtitle" />
        </VBox>

        <VBox layoutX="35.0" layoutY="110.0" prefWidth="975.0" prefHeight="260.0" spacing="18.0" styleClass="card">
            <Label text="Thiết lập quy định" styleClass="sectionTitle" />

            <GridPane hgap="22.0" vgap="16.0">
                <Label text="Số xe tối đa mỗi ngày" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtMaxCarsPerDay" promptText="30" styleClass="inputField" prefWidth="220.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            </GridPane>

            <HBox spacing="12.0">
                <Button fx:id="btnUpdateRegulations" text="Cập nhật quy định" styleClass="primaryBtn" prefWidth="165.0" />
                <Button fx:id="btnResetRegulations" text="Về mặc định" styleClass="secondaryBtn" prefWidth="130.0" />
                <Button fx:id="btnRefreshRegulations" text="Tải lại" styleClass="secondaryBtn" prefWidth="100.0" />
            </HBox>
        </VBox>
    </children>
</AnchorPane>
