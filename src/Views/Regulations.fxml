<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="800.0" prefWidth="1048.0"
            styleClass="pageRoot"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.RegulationsController">

    <stylesheets>
        <URL value="@../Assets/css/pages.css" />
    </stylesheets>

    <children>
        <VBox layoutX="35.0" layoutY="30.0" spacing="6.0">
            <Label text="Garage Regulations" styleClass="pageTitle" />
            <Label text="Change garage business rules according to QĐ1, QĐ2 and QĐ6." styleClass="pageSubtitle" />
        </VBox>

        <VBox layoutX="35.0" layoutY="110.0" prefWidth="975.0" prefHeight="330.0" spacing="18.0" styleClass="card">
            <Label text="Regulation Settings" styleClass="sectionTitle" />

            <GridPane hgap="22.0" vgap="16.0">
                <Label text="Max cars received per day" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtMaxCarsPerDay" promptText="30" styleClass="inputField" prefWidth="220.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Max car brands" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="txtMaxBrands" promptText="10" styleClass="inputField" prefWidth="220.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Max part types" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="txtMaxParts" promptText="200" styleClass="inputField" prefWidth="220.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Max labor types" styleClass="formLabel" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <TextField fx:id="txtMaxLabors" promptText="100" styleClass="inputField" prefWidth="220.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            </GridPane>

            <HBox spacing="12.0">
                <Button fx:id="btnUpdateRegulations" text="Update Regulations" styleClass="primaryBtn" prefWidth="165.0" />
                <Button fx:id="btnResetRegulations" text="Reset Default" styleClass="secondaryBtn" prefWidth="130.0" />
                <Button fx:id="btnRefreshRegulations" text="Refresh" styleClass="secondaryBtn" prefWidth="100.0" />
            </HBox>
        </VBox>
    </children>
</AnchorPane>